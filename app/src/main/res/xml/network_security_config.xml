<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is globally disabled. Only api.openai.com is allowed, over TLS, using the system trust store only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">api.openai.com</domain>
    </domain-config>
</network-security-config>
